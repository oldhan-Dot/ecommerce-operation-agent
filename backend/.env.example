# 仅用于本机后端，与项目根目录中供 Docker Compose 使用的 .env 文件不同。
# 运行环境：开发 dev、测试 test、预发 staging、生产 prod。
APP_ENV=dev
# 云端数据库地址；填写真实公网 IP 或域名，不填写 HTTP 协议前缀。
DB_HOST=
DB_PORT=3306
DB_NAME=ecommerce_agent
DB_USER=ecommerce_app
# 应用账号密码，对应云端 Compose 中的 MYSQL_PASSWORD。
DB_PASSWORD=
# 当前开发使用 DISABLED；启用证书验证时改为 VERIFY_IDENTITY。
DB_TLS_MODE=DISABLED
# 仅启用证书验证时填写可信 CA 路径。
DB_SSL_CA=
# 以下本机密钥在开发环境初始化时随机生成，请勿提交到版本库或公开分享。
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=local-v1
SESSION_PEPPER=
# 允许的前端来源，列表使用 JSON 格式。
TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 允许调用的模型服务域名，尚未接入时保留空列表。
ALLOWED_MODEL_HOSTS=[]
# 上传文件保存在后端受限目录，不与公开静态资源混用。
UPLOAD_DIR=.local/uploads
# Worker 环境检查间隔，单位为秒。
WORKER_POLL_SECONDS=10
